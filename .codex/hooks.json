{
  "description": "Project-local hooks for the Android knowledge repository.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File .codex/hooks/knowledge-stop-check.ps1",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -File .codex/hooks/knowledge-stop-check.ps1",
            "timeout": 120,
            "statusMessage": "Checking knowledge repository"
          }
        ]
      }
    ]
  }
}

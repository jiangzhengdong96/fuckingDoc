{
  "description": "Project-local hooks for the Android knowledge repository.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File \"$(git rev-parse --show-toplevel)/.codex/hooks/knowledge-stop-check.ps1\"",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -File \"C:\\Users\\jiang\\Desktop\\fuckingDoc\\.codex\\hooks\\knowledge-stop-check.ps1\"",
            "timeout": 120,
            "statusMessage": "Checking knowledge repository"
          }
        ]
      }
    ]
  }
}
